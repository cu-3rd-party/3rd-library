{
  // files to compile (type-check only, since noEmit: true)
  "include": [
    "src",
    "lingui.config.ts",
    "types/**/*.d.ts",
    "src/shared/ui",
    "src/shared/constants/allowedExtensions.ts",
    "src/shared/constants/difficulty.ts",
    "src/shared/constants/index.ts",
    "src/shared/constants/material.ts",
    "src/shared/constants/materialType.ts",
    "src/shared/constants/navigation.tsx",
    "src/shared/constants/routePrefixes.ts",
    "src/shared/constants/sort.ts",
    "src/shared/constants/sortConfig.tsx",
    "src/shared/constants/submissionStatus.ts",
    "src/shared/lib/cn.ts",
    "src/shared/api/api.ts",
    "src/entities/session/lib/authToken.ts",
    "src/entities/session/lib/currentUser.ts",
    "src/app/router",
    "src/entities/material/lib/getCourseName.ts",
    "src/entities/submission/lib/openMaterialFile.ts",
    "src/features/filter-sort-materials/lib/getFilterAttributes.ts",
    "src/features/filter-sort-materials/lib/getSortAttributes.ts",
    "src/features/filter-sort-materials/model/store.ts",
    "src/entities/submission/model/store.ts",
    "src/widgets/header/ui/MobileHeader.tsx",
    "src/widgets/header/ui/DesktopHeader.tsx",
    "src/entities/material/ui/MaterialCard.tsx",
    "src/entities/material/ui/MaterialBadge.tsx",
    "src/entities/user/ui/AuthorCard.tsx",
    "src/entities/submission/ui/SubmissionFileSection.tsx",
    "src/entities/submission/ui/SubmissionStatusBadge.tsx",
    "src/features/filter-sort-materials/ui/MaterialFilter.tsx",
    "src/features/filter-sort-materials/ui/MaterialSort.tsx",
    "src/features/filter-sort-materials/ui/DesktopFilters.tsx",
    "src/features/filter-sort-materials/ui/DesktopSort.tsx",
    "src/features/filter-sort-materials/ui/MobileFIlters.tsx",
    "src/features/filter-sort-materials/ui/MobileSort.tsx",
    "src/features/filter-sort-materials/ui/FilterSortSheet.tsx",
    "src/features/filter-sort-materials/ui/MobileMaterialSheet.tsx",
    "src/features/submit-material/ui/UploadMaterialForm.tsx",
    "src/features/submit-material/ui/CourseSelector.tsx",
    "src/features/submit-material/ui/DifficultySelector.tsx",
    "src/features/submit-material/ui/SubjectSelector.tsx",
    "src/features/submit-material/ui/TypeSelector.tsx",
    "src/features/submit-material/ui/MaterialAttributesSelector.tsx",
    "src/features/submit-material/ui/FileUploadArea.tsx",
    "src/features/submit-material/ui/CourseSelection.tsx",
    "src/features/moderate-submission/ui/SubmissionReviewDialog.tsx",
    "src/features/moderate-submission/ui/ModerationTabs.tsx",
    "src/widgets/moderation-grid/ui/ModerationSubmissionGrid.tsx",
    "src/widgets/materials-section/ui/MaterialTopPanel.tsx",
    "src/widgets/materials-section/ui/MaterialsSection.tsx",
    "src/widgets/authors-grid/ui/AuthorsGrid.tsx",
    "src/features/filter-sort-materials/ui/MaterialActionBar.tsx",
    "src/features/auth/ui/LoginAuthForm.tsx",
    "src/features/auth/ui/RegisterAuthForm.tsx",
    "src/features/auth/ui/AuthTextField.tsx",
    "src/features/auth/ui/AuthPasswordField.tsx",
    "src/features/auth/ui/AuthFooterLink.tsx",
    "src/features/auth/ui/AuthFieldError.tsx",
    "src/features/auth/ui/AuthMessage.tsx",
    "src/pages/authorization/AuthLayout.tsx",
    "src/pages/about/AboutPage.tsx",
    "src/pages/authorization/LoginPage.tsx",
    "src/pages/authorization/RegisterPage.tsx",
    "src/pages/authors/AuthorsPage.tsx",
    "src/pages/authors/ProfilePage.tsx",
    "src/pages/not-found/NotFoundPage.tsx",
    "src/pages/moderation/ModerationPage.tsx",
    "src/pages/materials/MaterialDetailsPage.tsx",
    "src/pages/materials/MaterialsPage.tsx",
    "src/pages/materials/UploadMaterialPage.tsx"
  ],
  "exclude": ["node_modules", "public/mockServiceWorker.js"],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "skipLibCheck": true,
    // Bundler mode
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["src/*"]
    }
  }
}
