{
  "name": "cu3rd-lib",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && cross-env VITE_API=server vite build",
    "docker:build": "docker build -f Dockerfile -t ipr-app:latest .",
    "docker:run-local": "docker run -p 8080:80 ipr-app:latest",
    "preview": "vite preview",
    "dev:host": "vite --host",
    "dev:mock": "cross-env VITE_API=mock vite",
    "msw:cleanup": "rm public/mockServiceWorker.js",
    "msw:gen": "pnpx msw init public --save",
    "test": "vitest",
    "format:eslint": "npm run lint:eslint -- --fix",
    "format:prettier": "npm run lint:prettier -- --write",
    "format": "npm run format:eslint && npm run format:prettier",
    "lint:eslint": "eslint \"**/*.{js,ts,tsx}\"",
    "lint:prettier": "prettier \"**/*.{json,js,ts,tsx}\" --check --write",
    "lint:ts": "tsc --noEmit",
    "lint": "npm run lint:eslint && npm run lint:prettier && npm run lint:ts",
    "generate": "vite generate",
    "clean": "rimraf node_modules",
    "plop": "plop",
    "lingui:extract": "lingui extract",
    "lingui:compile": "lingui compile",
    "translate": "pnpm lingui:extract && pnpm lingui:compile"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.20",
    "cu3rd-lib": "link:",
    "eslint": "^9.39.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.13.0",
    "uuid": "^13.0.0",
    "workbox-window": "^7.3.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "^5.6.0",
    "@lingui/vite-plugin": "^5.9.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "@vitejs/plugin-react": "^5.1.2",
    "cross-env": "^7.0.3",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "msw": "^2.11.6",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.2.0",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^1.0.4",
    "workbox-build": "^7.3.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
